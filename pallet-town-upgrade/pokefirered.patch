@@ -0,0 +1,30 @@
+PalletTown_PokemonCenter_1F_Text_NurseNoMon::
+	.string "Welcome to our POKéMON CENTER!\p"
+	.string "We heal tired POKéMON back to\n"
+	.string "perfect health…\p"
+	.string "…but you don't have any POKéMON\n"
+	.string "with you yet!\p"
+	.string "Once you have a partner POKéMON,\n"
+	.string "come and see me. I'll take good\l"
+	.string "care of it!$"
+
+PalletTown_PokemonCenter_1F_Text_Resident1::
+	.string "Hi! I'm MAY. I'm visiting from\n"
+	.string "LITTLEROOT TOWN in HOENN.\p"
+	.string "I came all this way to see\n"
+	.string "PROF. OAK's lab! The new wing\l"
+	.string "is even bigger than my dad's!$"
+
+PalletTown_PokemonCenter_1F_Text_Resident2::
+	.string "Shh! The INDIGO PLATEAU match\n"
+	.string "is on TV!\p"
+	.string "This POKéMON CENTER is brand\n"
+	.string "new! It still smells like paint.\p"
+	.string "Before, we had to walk all the\n"
+	.string "way to VIRIDIAN to heal up!$"
+
+PalletTown_PokemonCenter_1F_Text_Resident3::
+	.string "The NURSE here is my\n"
+	.string "granddaughter's best friend.\p"
+	.string "She treats every POKéMON like\n"
+	.string "it's her very own.$"
