--- /dev/null
+++ b/data/maps/PalletTown_Cafe/text.inc
@@ -0,0 +1,27 @@
+PalletTown_Cafe_Text_Resident1::
+    .string "Welcome to PALLET CAFÉ!\p"
+    .string "Today's special is ORAN\n"
+    .string "BERRY tea with honey.\p"
+    .string "TRAINERS swear it gets them\n"
+    .string "through a whole day of\l"
+    .string "battles!$"
+
+PalletTown_Cafe_Text_Resident2::
+    .string "I wait tables here to save\n"
+    .string "up for my first POKé BALL.\p"
+    .string "Can you believe what they\n"
+    .string "cost in the big cities?$"
+
+PalletTown_Cafe_Text_Resident3::
+    .string "I come here every morning to\n"
+    .string "read the paper.\p"
+    .string "Today's headline: “PALLET\n"
+    .string "TOWN now bigger than\l"
+    .string "VIRIDIAN?!”$"
+
+PalletTown_Cafe_Text_Resident4::
+    .string "I'm visiting from HOENN with\n"
+    .string "my friend MAY.\p"
+    .string "Your KANTO café makes a mean\n"
+    .string "berry tea! We have nothing\l"
+    .string "like it in LITTLEROOT.$"
