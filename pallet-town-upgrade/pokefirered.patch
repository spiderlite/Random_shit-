+++ b/data/maps/PalletTown_PokemonCenter_1F/scripts.inc
@@ -0,0 +1,46 @@
+PalletTown_PokemonCenter_1F_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, PalletTown_PokemonCenter_1F_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
+	.byte 0
+
+PalletTown_PokemonCenter_1F_OnTransition::
+	setrespawn HEAL_LOCATION_PALLET_TOWN
+	end
+
+PalletTown_PokemonCenter_1F_EventScript_Nurse::
+	lock
+	faceplayer
+	getpartysize
+	goto_if_eq VAR_RESULT, 0, PalletTown_PokemonCenter_1F_EventScript_NurseNoMon
+	call EventScript_PkmnCenterNurse
+	release
+	end
+
+PalletTown_PokemonCenter_1F_EventScript_NurseNoMon::
+	msgbox PalletTown_PokemonCenter_1F_Text_NurseNoMon
+	release
+	end
+
+PalletTown_PokemonCenter_1F_EventScript_Resident1::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_FEMALE
+	msgbox PalletTown_PokemonCenter_1F_Text_Resident1
+	release
+	end
+
+PalletTown_PokemonCenter_1F_EventScript_Resident2::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox PalletTown_PokemonCenter_1F_Text_Resident2
+	release
+	end
+
+PalletTown_PokemonCenter_1F_EventScript_Resident3::
+	lock
+	faceplayer
