@@ -0,0 +1,25 @@
+PalletTown_Cafe_Text_Resident1::
+	.string "Welcome to PALLET CAFÉ!\p"
+	.string "Today's special is ORAN BERRY\n"
+	.string "tea with honey.\p"
+	.string "TRAINERS swear it gets them\n"
+	.string "through a whole day of battles!$"
+
+PalletTown_Cafe_Text_Resident2::
+	.string "I wait tables here to save up\n"
+	.string "for my first POKé BALL.\p"
+	.string "Can you believe what they cost\n"
+	.string "in the big cities?$"
+
+PalletTown_Cafe_Text_Resident3::
+	.string "I come here every morning to\n"
+	.string "read the paper.\p"
+	.string "Today's headline: “PALLET TOWN\n"
+	.string "now bigger than VIRIDIAN?!”$"
+
+PalletTown_Cafe_Text_Resident4::
+	.string "I'm visiting from HOENN with\n"
+	.string "my friend MAY.\p"
+	.string "Your KANTO café makes a mean\n"
+	.string "berry tea! We have nothing like\l"
+	.string "it in LITTLEROOT.$"
