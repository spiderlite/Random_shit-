diff --git a/data/maps/PalletTown/text.inc b/data/maps/PalletTown/text.inc
index 726aea8..e0b07f2 100644
--- a/data/maps/PalletTown/text.inc
+++ b/data/maps/PalletTown/text.inc
@@ -65,3 +65,550 @@ PalletTown_Text_OakYouEnjoyingTraveling::
     .string "Good for you, good for you.\n"
     .string "Hohoho.$"
 
+
+PalletTown_Text_HarperHouseMailbox::
+    .string "HARPER's house$"
+
+PalletTown_Text_AokiHouseMailbox::
+    .string "AOKI's house$"
+
+PalletTown_Text_BellHouseMailbox::
+    .string "BELL's house$"
+
+PalletTown_Text_ValeHouseMailbox::
+    .string "VALE's house$"
+
+PalletTown_Text_MarshHouseMailbox::
+    .string "MARSH's house$"
+
+PalletTown_Text_KowalskiHouseMailbox::
+    .string "KOWALSKI's house$"
+
+PalletTown_Text_CafeSign::
+    .string "PALLET CAFÉ Fresh berry tea\n"
+    .string "every morning!$"
+
+PalletTown_Text_NurserySign::
+    .string "POKéMON NURSERY Little ones\n"
+    .string "welcome. Please be gentle!$"
+
+PalletTown_Text_SchoolSign::
+    .string "PALLET TRAINER SCHOOL Every\n"
+    .string "champion started somewhere!$"
+
+PalletTown_Text_BreederHouseMailbox::
+    .string "LILA's house$"
+
+PalletTown_Text_ParkSign::
+    .string "PALLET PARK New TRAINERS,\n"
+    .string "test your skills here!$"
+
+PalletTown_Text_Townsfolk1::
+    .string "Welcome to PALLET TOWN!\p"
+    .string "It's gotten busy since the\n"
+    .string "market district opened.\p"
+    .string "Mind the little ones by the\n"
+    .string "fountain, now!$"
+
+PalletTown_Text_Townsfolk2::
+    .string "Mail for the HARPERS… mail\n"
+    .string "for the AOKIS…\p"
+    .string "PALLET's gotten so big, my\n"
+    .string "bag is twice as heavy as\l"
+    .string "last year!$"
+
+PalletTown_Text_Townsfolk3::
+    .string "The fountain sparkles when\n"
+    .string "the sun comes up over the\l"
+    .string "sea!$"
+
+PalletTown_Text_Townsfolk4::
+    .string "Ahh… a bench in the park.\p"
+    .string "This is the life. No\n"
+    .string "battles, no homework. Just\l"
+    .string "sunshine.$"
+
+PalletTown_Text_Townsfolk5::
+    .string "Tag! You're it! …Wait,\n"
+    .string "you're not playing?$"
+
+PalletTown_Text_Townsfolk6::
+    .string "PIDGEY: Pijji! Pijji!$"
+
+PalletTown_Text_Townsfolk7::
+    .string "PIDGEY: Pijji?$"
+
+PalletTown_Text_Townsfolk8::
+    .string "I planted these pines the\n"
+    .string "year PROF. OAK built his\l"
+    .string "lab.\p"
+    .string "They've grown taller than\n"
+    .string "me!$"
+
+PalletTown_Text_Townsfolk9::
+    .string "We just finished the POKéMON\n"
+    .string "CENTER and the MART.\p"
+    .string "Next up, the mayor wants a\n"
+    .string "ferry pier down by the pond!$"
+
+PalletTown_Text_Townsfolk10::
+    .string "My MEOWTH and I take a\n"
+    .string "stroll every afternoon.\p"
+    .string "She chooses the route. I\n"
+    .string "merely follow.$"
+
+PalletTown_Text_Townsfolk11::
+    .string "MEOWTH: Meowth! Nya!$"
+
+PalletTown_Text_Townsfolk12::
+    .string "Zzz… Zzz…\p"
+    .string "…Huh? Oh, I'm just napping\n"
+    .string "in the sun. Best spot in\l"
+    .string "town.\p"
+    .string "Zzz…$"
+
+PalletTown_Text_Townsfolk13::
+    .string "SLOWPOKE: …… …… Yawn?$"
+
+PalletTown_Text_Townsfolk14::
+    .string "Hup! Hup! Hup!\p"
+    .string "Five laps of EAST STREET\n"
+    .string "before breakfast!\p"
+    .string "My MANKEY says I'm slow.\n"
+    .string "Hmph! Not for long!$"
+
+PalletTown_Text_Townsfolk15::
+    .string "The LEMONADE here is made\n"
+    .string "with ORAN BERRIES, you know.\p"
+    .string "…At least, that's what the\n"
+    .string "sign says. I can't taste it.$"
+
+PalletTown_Text_Townsfolk16::
+    .string "Go, POOCHYENA! TACKLE!\p"
+    .string "…Huh? Don't distract us! My\n"
+    .string "cousin mailed me this\l"
+    .string "POOCHYENA all the way from\l"
+    .string "HOENN!$"
+
+PalletTown_Text_Townsfolk17::
+    .string "POOCHYENA: Grrrr… Ruff!\n"
+    .string "Ruff!$"
+
+PalletTown_Text_Townsfolk18::
+    .string "ZIGZAGOON: Zig! Zagoo!$"
+
+PalletTown_Text_Townsfolk19::
+    .string "ZIGZAGOON, HEADBUTT!\p"
+    .string "We're tied, three wins each.\n"
+    .string "Loser buys the LEMONADE at\l"
+    .string "the market stall!$"
+
+PalletTown_Text_Townsfolk20::
+    .string "PSYDUCK: Psy…? …Duck!$"
+
+PalletTown_Text_StallVendor::
+    .string "Morning! Fresh from the\n"
+    .string "farms up on ROUTE 1!\p"
+    .string "The veggies are for the\n"
+    .string "café, but the drinks are\l"
+    .string "ice-cold and for sale!$"
+
+PalletTown_Text_StallBye::
+    .string "Stay hydrated out there,\n"
+    .string "kid! Your POKéMON too!$"
+
+PalletTown_Text_TimmyNoMon::
+    .string "Shorts are comfy and easy to\n"
+    .string "battle in!\p"
+    .string "Huh? You don't even have a\n"
+    .string "POKéMON? Get one, then we'll\l"
+    .string "talk!$"
+
+PalletTown_Text_TimmyAsk::
+    .string "My RATTATA is in the top\n"
+    .string "percentage of RATTATA!\p"
+    .string "You've got a POKéMON now,\n"
+    .string "huh? Wanna battle?$"
+
+PalletTown_Text_TimmyAccept::
+    .string "Yes! Get ready to be\n"
+    .string "schooled!$"
+
+PalletTown_Text_TimmyDecline::
+    .string "Scared, huh? I get it. We're\n"
+    .string "pretty much unbeatable.$"
+
+PalletTown_Text_TimmyDefeat::
+    .string "Wh-what?! My top percentage\n"
+    .string "RATTATA lost?!$"
+
+PalletTown_Text_TimmyAfter::
+    .string "I'm gonna train every day\n"
+    .string "until RATTATA is the top-top\l"
+    .string "percentage!$"
+
+PalletTown_Text_MilaNoMon::
+    .string "I named my ODDISH “Sprout”\n"
+    .string "and my NIDORAN “Blossom.”\p"
+    .string "Once you have a POKéMON, you\n"
+    .string "should give it a cute name\l"
+    .string "too!$"
+
+PalletTown_Text_MilaAsk::
+    .string "Oh! Is that your very first\n"
+    .string "POKéMON? It's adorable!\p"
+    .string "Sprout and Blossom would\n"
+    .string "love to play. Will you\l"
+    .string "battle us?$"
+
+PalletTown_Text_MilaAccept::
+    .string "Yay! Let's do our best,\n"
+    .string "girls!$"
+
+PalletTown_Text_MilaDecline::
+    .string "Aww. Maybe after your\n"
+    .string "POKéMON has had a little\l"
+    .string "nap.$"
+
+PalletTown_Text_MilaDefeat::
+    .string "Oh no, Sprout! Blossom! You\n"
+    .string "were both so brave!$"
+
+PalletTown_Text_MilaAfter::
+    .string "Losing is OK as long as we\n"
+    .string "have fun together. Right,\l"
+    .string "Sprout?$"
+
+PalletTown_Text_WesNoMon::
+    .string "Shh! I'm watching this pine\n"
+    .string "tree. Something wiggled up\l"
+    .string "there!\p"
+    .string "Come back with a POKéMON and\n"
+    .string "I'll show you my bug team!$"
+
+PalletTown_Text_WesAsk::
+    .string "BUG POKéMON grow up so fast!\n"
+    .string "That's what makes them the\l"
+    .string "best!\p"
+    .string "Want to see how tough my\n"
+    .string "bugs are? Battle me!$"
+
+PalletTown_Text_WesAccept::
+    .string "Go, my creepy-crawly crew!$"
+
+PalletTown_Text_WesDecline::
+    .string "Fine! I'll go back to\n"
+    .string "staring at this tree.$"
+
+PalletTown_Text_WesDefeat::
+    .string "My bugs got squished!$"
+
+PalletTown_Text_WesAfter::
+    .string "Someday CATERPIE will be a\n"
+    .string "BUTTERFREE. Then watch out!$"
+
+PalletTown_Text_DrewNoMon::
+    .string "I pitched my tent right here\n"
+    .string "in the park. Best spot in\l"
+    .string "PALLET!\p"
+    .string "Every camper needs a\n"
+    .string "partner. Go get yourself a\l"
+    .string "POKéMON!$"
+
+PalletTown_Text_DrewAsk::
+    .string "Nothing like a battle under\n"
+    .string "the open sky!\p"
+    .string "You and your partner up for\n"
+    .string "a match? Let's go!$"
+
+PalletTown_Text_DrewAccept::
+    .string "That's the spirit! Here I\n"
+    .string "come!$"
+
+PalletTown_Text_DrewDecline::
+    .string "No worries. The sky's not\n"
+    .string "going anywhere. Come back\l"
+    .string "anytime!$"
+
+PalletTown_Text_DrewDefeat::
+    .string "Whoa! You've got real\n"
+    .string "outdoor grit!$"
+
+PalletTown_Text_DrewAfter::
+    .string "Toughen up out here, and\n"
+    .string "VIRIDIAN FOREST won't scare\l"
+    .string "you one bit.$"
+
+PalletTown_Text_RosaNoMon::
+    .string "I packed sandwiches for a\n"
+    .string "picnic, but MEOWTH ate them\l"
+    .string "all!\p"
+    .string "When you have a POKéMON,\n"
+    .string "let's have a battle picnic!$"
+
+PalletTown_Text_RosaAsk::
+    .string "A battle before lunch builds\n"
+    .string "an appetite!\p"
+    .string "Will you battle with me and\n"
+    .string "my hungry friends?$"
+
+PalletTown_Text_RosaAccept::
+    .string "Hooray! Ready, set, picnic!$"
+
+PalletTown_Text_RosaDecline::
+    .string "OK! I'll save you a\n"
+    .string "sandwich. If MEOWTH doesn't\l"
+    .string "find it first.$"
+
+PalletTown_Text_RosaDefeat::
+    .string "Oh! Now we're even hungrier!$"
+
+PalletTown_Text_RosaAfter::
+    .string "Battling outdoors is the\n"
+    .string "best. Even better with\l"
+    .string "snacks!$"
+
+PalletTown_Text_OttoNoMon::
+    .string "Thirty years I've fished\n"
+    .string "this pond. Thirty years!\p"
+    .string "Come back with a POKéMON and\n"
+    .string "I'll show you what I've\l"
+    .string "caught.$"
+
+PalletTown_Text_OttoAsk::
+    .string "Patience, youngster. That's\n"
+    .string "the secret to fishing and\l"
+    .string "battling.\p"
+    .string "Let's see if you have any.\n"
+    .string "Care for a battle?$"
+
+PalletTown_Text_OttoAccept::
+    .string "Heh heh. Reel 'em in!$"
+
+PalletTown_Text_OttoDecline::
+    .string "Patient AND careful. You'll\n"
+    .string "make a fine angler someday.$"
+
+PalletTown_Text_OttoDefeat::
+    .string "Ho! You landed a big one!$"
+
+PalletTown_Text_OttoAfter::
+    .string "My MAGIKARP will grow into\n"
+    .string "something fierce. I can\l"
+    .string "wait.\p"
+    .string "I've waited thirty years\n"
+    .string "already!$"
+
+PalletTown_Text_DuncanNoMon::
+    .string "Ahoy! I ship out for\n"
+    .string "CINNABAR on the next tide.\p"
+    .string "Come back with a POKéMON and\n"
+    .string "I'll show you what sailors\l"
+    .string "do!$"
+
+PalletTown_Text_DuncanAsk::
+    .string "I'm sailing for CINNABAR,\n"
+    .string "but the tide can wait!\p"
+    .string "I'll use my newly caught\n"
+    .string "POKéMON on you, rookie!\l"
+    .string "Ready?$"
+
+PalletTown_Text_DuncanAccept::
+    .string "Anchors aweigh!$"
+
+PalletTown_Text_DuncanDecline::
+    .string "Ha! Smart. Never fight a\n"
+    .string "sailor in his own harbor.$"
+
+PalletTown_Text_DuncanDefeat::
+    .string "Sunk! Sunk like a stone!$"
+
+PalletTown_Text_DuncanAfter::
+    .string "I'll train KRABBY all the\n"
+    .string "way to CINNABAR. Next time,\l"
+    .string "rookie!$"
+
+PalletTown_Text_KaiNoMon::
+    .string "I'm going to CINNABAR to\n"
+    .string "train under BLAINE! FIRE all\l"
+    .string "the way!\p"
+    .string "You don't even have a\n"
+    .string "POKéMON? Better hurry up!$"
+
+PalletTown_Text_KaiAsk::
+    .string "I just caught GROWLITHE! Now\n"
+    .string "I'm ready for CINNABAR!\p"
+    .string "I'll use my newly caught\n"
+    .string "POKéMON on you, rookie!\l"
+    .string "Battle?$"
+
+PalletTown_Text_KaiAccept::
+    .string "Fire it up!$"
+
+PalletTown_Text_KaiDecline::
+    .string "Huh. Afraid of getting\n"
+    .string "burned, rookie?$"
+
+PalletTown_Text_KaiDefeat::
+    .string "My flames… fizzled out…$"
+
+PalletTown_Text_KaiAfter::
+    .string "Guess I need more training\n"
+    .string "before I face BLAINE.$"
+
+PalletTown_Text_OwenNoMon::
+    .string "They say there's a volcano\n"
+    .string "on CINNABAR. I want to climb\l"
+    .string "it!\p"
+    .string "Get a POKéMON and we'll see\n"
+    .string "who the tougher hiker is!$"
+
+PalletTown_Text_OwenAsk::
+    .string "I'm waiting for my friend so\n"
+    .string "we can head for CINNABAR.\p"
+    .string "Want to warm up with a\n"
+    .string "battle while I wait?$"
+
+PalletTown_Text_OwenAccept::
+    .string "Rock solid! Let's go!$"
+
+PalletTown_Text_OwenDecline::
+    .string "No problem. I'll just keep\n"
+    .string "waiting… and waiting…$"
+
+PalletTown_Text_OwenDefeat::
+    .string "You crushed us like gravel!$"
+
+PalletTown_Text_OwenAfter::
+    .string "KAI's late again. He's\n"
+    .string "probably battling somebody.$"
+
+PalletTown_Text_BreeNoMon::
+    .string "Mommy says CINNABAR has the\n"
+    .string "best beaches in KANTO!\p"
+    .string "Do you have a POKéMON? No?\n"
+    .string "Then we can't play!$"
+
+PalletTown_Text_BreeAsk::
+    .string "I'm going to CINNABAR on a\n"
+    .string "big boat! I'm practicing\l"
+    .string "first!\p"
+    .string "Will you battle me? Please?$"
+
+PalletTown_Text_BreeAccept::
+    .string "Yay! Splash, splash!$"
+
+PalletTown_Text_BreeDecline::
+    .string "Aww… meanie.$"
+
+PalletTown_Text_BreeDefeat::
+    .string "Waaah! I lost!$"
+
+PalletTown_Text_BreeAfter::
+    .string "When I grow up, I'll SURF\n"
+    .string "all the way to CINNABAR\l"
+    .string "myself!$"
+
+PalletTown_Text_JuneNoMon::
+    .string "I come to this garden to\n"
+    .string "relax after school.\p"
+    .string "The flowers smell so nice.\n"
+    .string "Don't you think so?$"
+
+PalletTown_Text_JuneAsk::
+    .string "Relaxing is nice, but a\n"
+    .string "gentle battle is nice too.\p"
+    .string "Would you like to have one?$"
+
+PalletTown_Text_JuneAccept::
+    .string "Let's take it easy, OK?$"
+
+PalletTown_Text_JuneDecline::
+    .string "That's fine. Stop and smell\n"
+    .string "the flowers for a while.$"
+
+PalletTown_Text_JuneDefeat::
+    .string "Oh my. That wasn't very\n"
+    .string "relaxing at all!$"
+
+PalletTown_Text_JuneAfter::
+    .string "Back to my flowers. Come\n"
+    .string "relax here anytime.$"
+
+PalletTown_Text_PipNoMon::
+    .string "The flower garden is full of\n"
+    .string "BUG POKéMON at night!\p"
+    .string "Get a POKéMON and I'll show\n"
+    .string "you my collection!$"
+
+PalletTown_Text_PipAsk::
+    .string "WES says his bugs are the\n"
+    .string "best in PALLET. He's wrong!\p"
+    .string "Battle me and you'll see!$"
+
+PalletTown_Text_PipAccept::
+    .string "Bzzzt! Here we go!$"
+
+PalletTown_Text_PipDecline::
+    .string "Fine! I'll go find more\n"
+    .string "bugs.$"
+
+PalletTown_Text_PipDefeat::
+    .string "Aww! Don't tell WES!$"
+
+PalletTown_Text_PipAfter::
+    .string "VENONAT can see in the dark.\n"
+    .string "That's how we find more\l"
+    .string "bugs!$"
+
+PalletTown_Text_MiloNoMon::
+    .string "I've read every book about\n"
+    .string "POKéMON in the SCHOOL\l"
+    .string "library!\p"
+    .string "Now I just need a POKéMON to\n"
+    .string "battle with. Same as you!$"
+
+PalletTown_Text_MiloAsk::
+    .string "Did you know SLOWPOKE takes\n"
+    .string "a whole five seconds to feel\l"
+    .string "pain?\p"
+    .string "Let's test that! Battle?$"
+
+PalletTown_Text_MiloAccept::
+    .string "For science!$"
+
+PalletTown_Text_MiloDecline::
+    .string "Hmph. A missed opportunity\n"
+    .string "for research.$"
+
+PalletTown_Text_MiloDefeat::
+    .string "Fascinating! Utterly\n"
+    .string "fascinating!$"
+
+PalletTown_Text_MiloAfter::
+    .string "I'll write all about our\n"
+    .string "battle in my notebook\l"
+    .string "tonight.$"
+
+PalletTown_Text_IvyNoMon::
+    .string "I'm on my way to the CAFÉ\n"
+    .string "for berry tea!\p"
+    .string "Get yourself a POKéMON, then\n"
+    .string "we'll battle over a cup!$"
+
+PalletTown_Text_IvyAsk::
+    .string "A quick battle before tea?\n"
+    .string "Sounds perfect to me!$"
+
+PalletTown_Text_IvyAccept::
+    .string "Ready, set, sip!$"
+
+PalletTown_Text_IvyDecline::
+    .string "Suit yourself! More tea for\n"
+    .string "me.$"
+
+PalletTown_Text_IvyDefeat::
+    .string "Oh! My tea's gone cold.$"
+
+PalletTown_Text_IvyAfter::
+    .string "Next time, the tea's on you!$"
