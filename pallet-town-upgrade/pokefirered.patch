diff --git a/data/maps/PalletTown_Mart/scripts.inc b/data/maps/PalletTown_Mart/scripts.inc
new file mode 100644
index 0000000..9c9f8d4
--- /dev/null
+++ b/data/maps/PalletTown_Mart/scripts.inc
@@ -0,0 +1,41 @@
+PalletTown_Mart_MapScripts::
+	.byte 0
+
+PalletTown_Mart_EventScript_Clerk::
+	goto_if_questlog EventScript_ReleaseEnd
+	lock
+	faceplayer
+	message Text_MayIHelpYou
+	waitmessage
+	pokemart PalletTown_Mart_Items
+	msgbox Text_PleaseComeAgain
+	release
+	end
+
+	.align 2
+PalletTown_Mart_Items::
+	.2byte ITEM_POTION
+	.2byte ITEM_ANTIDOTE
+	.2byte ITEM_PARALYZE_HEAL
+	.2byte ITEM_AWAKENING
+	.2byte ITEM_BURN_HEAL
+	.2byte ITEM_ESCAPE_ROPE
+	.2byte ITEM_NONE
+	release
+	end
+
+PalletTown_Mart_EventScript_Resident1::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_FEMALE
+	msgbox PalletTown_Mart_Text_Resident1
+	release
+	end
+
+PalletTown_Mart_EventScript_Resident2::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox PalletTown_Mart_Text_Resident2
+	release
+	end
